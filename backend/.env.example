# SLMS Backend Environment Configuration
PORT=10000
NODE_ENV=production

# MongoDB Atlas Database URI
# Replace USERNAME, PASSWORD, and CLUSTER with your Atlas details
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/slms_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=slms_production_super_secret_jwt_key_2026

# Allowed Frontend Production Client URLs (Comma-separated for multiple origins)
CLIENT_URL=https://slms-frontend.vercel.app,http://localhost:5173
ADMIN_URL=https://slms-admin.vercel.app,http://localhost:4200
